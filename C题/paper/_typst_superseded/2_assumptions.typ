  [$E_t$], [时段末储电量（kWh）],
  [$q_t$], [计划/常规购电量（kWh/时段）],
  [$a_t$], [调整购电量（kWh/时段，问题3）],
  [$e_t^{em}$], [紧急购电量（kWh/时段）],
  [$curt_t$], [弃光量（kWh/时段）],
